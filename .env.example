# ==========================================
# SELLORA — Production Environment Variables
# Retail Intelligence for Small Businesses
# ==========================================

# Next.js Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://sellora.app

# Supabase PostgreSQL & Authentication (Optional for cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection String (Direct PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Currency & Locale Configurations
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
